\begin_layout Subsection
Indices
\end_layout

\begin_layout Standard
\begin_inset Formula $\forall a\in\mathbb{N}$
\end_inset

 and 
\begin_inset Formula $\forall b>1$
\end_inset

,
 
\begin_inset Formula $\exists n\in\mathbb{N}^{*}$
\end_inset

 and 
\begin_inset Formula $\exists a_{0},\ldots,a_{n-1}\in\mathbb{Z}_{b}$
\end_inset

,
 such that
\begin_inset Formula 
\[
a=\sum\nolimits^{n-1}_{i=0}a_{i}b^{i},
\]

\end_inset

which forms the representation of 
\begin_inset Formula $a$
\end_inset

 on base 
\begin_inset Formula $b$
\end_inset

.
 In particular,
 
\begin_inset Formula $a<b^{n}$
\end_inset

 and the representation is unique up to 0–padding.
\end_layout

\begin_layout Standard
\begin_inset Formula $\forall B\in\mathbb{N}^{*}$
\end_inset

,
 
\begin_inset Formula $\mathbb{Z}_{B}\subset\mathbb{N}$
\end_inset

 is also a finite integer index set.
 For 
\begin_inset Formula $B=b^{n}$
\end_inset

,
 
\begin_inset Formula $\forall a\in\mathbb{Z}_{B}$
\end_inset

,
 
\begin_inset Formula $\exists!a_{0},\ldots,a_{n-1}\in\mathbb{Z}_{b}$
\end_inset

,
 such that
\begin_inset Formula 
\[
a=\sum\nolimits^{n-1}_{i=0}a_{i}b^{i}.
\]

\end_inset

This makes finite index sets 
\begin_inset Formula $\mathbb{Z}_{B}$
\end_inset

