\end_layout

\begin_layout Description
scalar
\begin_inset space ~
\end_inset

multiplication 
\begin_inset Formula $\cdot\colon R\times M\to M:a,(x_{1},\ldots,x_{n})\mapsto(ax_{1},\ldots,ax_{n})$
\end_inset

,
\end_layout

\end_deeper
