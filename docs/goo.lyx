\begin_layout Definition
A 
\emph on
semigroup
\emph default
 is a nonempty set 
\begin_inset Formula $G$
\end_inset

 with a binary operation 
\begin_inset Formula $\circ\colon G\times G\to G$
\end_inset

 that is 
\emph on
associative
\emph default
;
 equivalently:
\end_layout

\begin_deeper
\begin_layout Description
associativity 
\begin_inset Formula $\forall a,b,c\in G$
\end_inset

,
 
\begin_inset Formula $a\circ(b\circ c)=(a\circ b)\circ c$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Definition
A 
\emph on
monoid
\emph default
 is a semigroup 
\begin_inset Formula $G$
\end_inset

 whose operation 
\begin_inset Formula $\circ$
\end_inset

 also admits an 
\emph on
identity
\emph default
 
\begin_inset Formula $\mathds{1}$
\end_inset

;
 equivalently:
\end_layout

\begin_deeper
\begin_layout Description
identity 
\begin_inset Formula $\exists!\mathds{1}\in G$
\end_inset

,
 such that 
\begin_inset Formula $\forall a\in G$
\end_inset

,
 
\begin_inset Formula $a\circ\mathds{1}=\mathds{1}\circ a=a$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Definition
A 
\emph on
group
\emph default
 is a monoid 
\begin_inset Formula $G$
\end_inset

 whose operation 
\begin_inset Formula $\circ$
\end_inset

 also supports 
\emph on
inverses
\emph default
 relative to the identity 
\begin_inset Formula $\mathds{1}$
\end_inset

;
 equivalently:
\end_layout

\begin_deeper
\begin_layout Description
inverse 
\begin_inset Formula $\forall a\in G$
\end_inset

,
 
\begin_inset Formula $\exists!a^{-1}\in G$
\end_inset

 such that 
\begin_inset Formula $a\circ a^{-1}=a^{-1}\circ a=\mathds{1}$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Definition
An 
\emph on
abelian
\emph default
 group is a group 
\begin_inset Formula $G$
\end_inset

 whose operation 
\begin_inset Formula $\circ$
\end_inset

 is also commutative;
 equivalently:
\end_layout

\begin_deeper
\begin_layout Description
commutativity 
\begin_inset Formula $\forall a,b\in G$
\end_inset

,
 
\begin_inset Formula $a\circ b=b\circ a$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Standard
The uniqueness of the identity and of each element's inverse follows from these axioms.
 This allows a single identity symbol and an inverse notation linking each element to its inverse.
\end_layout

