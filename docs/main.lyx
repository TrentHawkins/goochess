\end_layout

\begin_layout Section
Foundations
\end_layout

\begin_layout Subsection
Fields
\end_layout

\begin_layout Definition
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Field
\end_layout

\end_inset

A field consists of a set 
\begin_inset Formula $F$
\end_inset
 equipped with addition and multiplication,
 two binary operations on 
\begin_inset Formula $F$
\end_inset
:
\begin_inset Formula \[
+\colon F\times F\to F,\qquad \cdot\colon F\times F\to F.
\]
\end_inset
Each operation assigns a unique field element to each ordered pair of field elements.
 The following field axioms hold for all 
\begin_inset Formula $a,b,c\in F$
\end_inset
.
\end_layout

\begin_deeper
\begin_layout Enumerate
\series bold
Associative addition and multiplication.
\series default
 
\begin_inset Formula $a+(b+c)=(a+b)+c$
\end_inset
 and 
\begin_inset Formula $a\cdot(b\cdot c)=(a\cdot b)\cdot c$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Commutative addition and multiplication.
\series default
 
\begin_inset Formula $a+b=b+a$
\end_inset
 and 
\begin_inset Formula $a\cdot b=b\cdot a$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Additive and multiplicative identities.
\series default
 There are constants 
\begin_inset Formula $0,1\in F$
\end_inset
 with 
\begin_inset Formula $0\ne1$
\end_inset
, satisfying 
\begin_inset Formula $a+0=a$
\end_inset
 and 
\begin_inset Formula $a\cdot1=a$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Additive inverses.
\series default
 Each 
\begin_inset Formula $a\in F$
\end_inset
 has an additive inverse 
\begin_inset Formula $-a\in F$
\end_inset
 satisfying 
\begin_inset Formula $a+(-a)=0$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Multiplicative inverses.
\series default
 Each nonzero 
\begin_inset Formula $a\in F$
\end_inset
 has a multiplicative inverse 
\begin_inset Formula $a^{-1}\in F$
\end_inset
 satisfying 
\begin_inset Formula $a\cdot a^{-1}=1$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Multiplication distributes over addition.
\series default
 
\begin_inset Formula $a\cdot(b+c)=(a\cdot b)+(a\cdot c)$
\end_inset
.
\end_layout

\end_deeper

\begin_layout Subsection
Vectors
\end_layout

\begin_layout Definition
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Vector space
\end_layout

\end_inset

A vector space over a field 
\begin_inset Formula $F$
\end_inset
 is a nonempty set 
\begin_inset Formula $V$
\end_inset
 with vector addition and scalar multiplication:
\begin_inset Formula \[
\begin{aligned}+\colon V\times V&\to V,& (\mathbf{v},\mathbf{w})&\mapsto\mathbf{v}+\mathbf{w},\\ \cdot\colon F\times V&\to V,& (a,\mathbf{v})&\mapsto a\mathbf{v}.\end{aligned}
\]
\end_inset
Elements of 
\begin_inset Formula $V$
\end_inset
 are vectors; elements of 
\begin_inset Formula $F$
\end_inset
 are scalars.
 For all 
\begin_inset Formula $\mathbf{u},\mathbf{v},\mathbf{w}\in V$
\end_inset
 and 
\begin_inset Formula $a,b\in F$
\end_inset
, the following eight axioms hold:
\end_layout

\begin_deeper
\begin_layout Enumerate
\series bold
Addition is associative.
\series default
 
\begin_inset Formula $\mathbf{u}+(\mathbf{v}+\mathbf{w})=(\mathbf{u}+\mathbf{v})+\mathbf{w}$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Addition is commutative.
\series default
 
\begin_inset Formula $\mathbf{u}+\mathbf{v}=\mathbf{v}+\mathbf{u}$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Additive identity.
\series default
 There is a zero vector 
\begin_inset Formula $\mathbf{0}\in V$
\end_inset
 with 
\begin_inset Formula $\mathbf{v}+\mathbf{0}=\mathbf{v}$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Additive inverses.
\series default
 Each 
\begin_inset Formula $\mathbf{v}\in V$
\end_inset
 has an additive inverse 
\begin_inset Formula $-\mathbf{v}\in V$
\end_inset
 satisfying 
\begin_inset Formula $\mathbf{v}+(-\mathbf{v})=\mathbf{0}$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Compatibility of scalar multiplication.
\series default
 
\begin_inset Formula $a(b\mathbf{v})=(ab)\mathbf{v}$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Scalar identity.
\series default
 
\begin_inset Formula $1\mathbf{v}=\mathbf{v}$
\end_inset
, with 
\begin_inset Formula $1$
\end_inset
 the field's multiplicative identity.
\end_layout

\begin_layout Enumerate
\series bold
Distributivity over vector addition.
\series default
 
\begin_inset Formula $a(\mathbf{u}+\mathbf{v})=a\mathbf{u}+a\mathbf{v}$
\end_inset
.
\end_layout

\begin_layout Enumerate
\series bold
Distributivity over scalar addition.
\series default
 
\begin_inset Formula $(a+b)\mathbf{v}=a\mathbf{v}+b\mathbf{v}$
\end_inset
.
\end_layout

\end_deeper

\begin_layout Subsubsection
Bases and dimension
\end_layout

\begin_layout Definition
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Linear combinations and span
\end_layout

\end_inset

For 
\begin_inset Formula $G\subseteq V$
\end_inset
, linear combinations are finite sums
\begin_inset Formula \[
\sum_{i=1}^{m}a_i\mathbf{g}_i,\qquad a_i\in F,\quad\mathbf{g}_i\in G,\quad m\in\mathbb{Z}_{\ge0}.
\]
\end_inset
Their set is 
\begin_inset Formula $\operatorname{span}_F(G)$
\end_inset
.
\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset

\end_layout

\begin_layout Definition
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Linear independence
\end_layout

\end_inset

\begin_inset Formula $G$
\end_inset
 is linearly independent if, for every finite choice of distinct 
\begin_inset Formula $\mathbf{g}_1,\ldots,\mathbf{g}_m\in G$
\end_inset
 and scalars 
\begin_inset Formula $a_1,\ldots,a_m\in F$
\end_inset
,
\begin_inset Formula \[
\sum_{i=1}^{m}a_i\mathbf{g}_i=\mathbf{0}\quad\Longleftrightarrow\quad a_1=\cdots=a_m=0.
\]
\end_inset
\end_layout

\begin_layout Standard
\begin_inset Separator parbreak
\end_inset

\end_layout

\begin_layout Definition
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Basis and dimension
\end_layout

\end_inset

A basis is a linearly independent subset spanning 
\begin_inset Formula $V$
\end_inset
.
 All bases have equal cardinality, the dimension 
\begin_inset Formula $\dim_F V$
\end_inset
.
\end_layout

\begin_layout Subsubsection
Coordinates and tuple representation
\end_layout

\begin_layout Definition
\begin_inset Argument 1
status open

\begin_layout Plain Layout
Coordinate representation
\end_layout

\end_inset

A finite ordered basis 
\begin_inset Formula $B=(\mathbf{b}_1,\ldots,\mathbf{b}_n)$
\end_inset
 gives each 
\begin_inset Formula $\mathbf{v}\in V$
\end_inset
 unique coordinates 
\begin_inset Formula $a_1,\ldots,a_n\in F$
\end_inset
:
\begin_inset Formula \[
\mathbf{v}=a_1\mathbf{b}_1+\cdots+a_n\mathbf{b}_n.
\]
\end_inset
The coordinate vector is
\begin_inset Formula \[
[\mathbf{v}]_B=(a_1,\ldots,a_n)\in F^n.
\]
\end_inset
\end_layout

\begin_layout Standard
The coordinate space 
\begin_inset Formula $F^n$
\end_inset
 uses componentwise operations:
\begin_inset Formula \[
\begin{aligned}(a_1,\ldots,a_n)+(b_1,\ldots,b_n)&=(a_1+b_1,\ldots,a_n+b_n),\\ c(a_1,\ldots,a_n)&=(ca_1,\ldots,ca_n),\qquad c\in F.\end{aligned}
\]
\end_inset
The coordinate map 
\begin_inset Formula $\Phi_B\colon V\to F^n,\ \mathbf{v}\mapsto[\mathbf{v}]_B$
\end_inset
 is a bijective linear map (a vector-space isomorphism):
\begin_inset Formula \[
\Phi_B(\mathbf{v}+\mathbf{w})=\Phi_B(\mathbf{v})+\Phi_B(\mathbf{w}),\qquad\Phi_B(c\mathbf{v})=c\Phi_B(\mathbf{v}).
\]
\end_inset
Thus vectors have an ordered tuple representation relative to the chosen basis.
\end_layout

